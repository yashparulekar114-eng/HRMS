# Copy to .env.local and fill in. Never commit .env.local. Blank values only in this file.

# Clerk (sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
CLERK_SECRET_KEY=

# Neon Postgres. Two connection strings for two different jobs:
# DATABASE_URL        -> the app, role `app_user` (not the owner), POOLED endpoint (host contains "-pooler")
# DATABASE_URL_DIRECT -> migrations only (npm run db:migrate), owner role, DIRECT endpoint. Never used by the app.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Ask HR is OPTIONAL: leave these blank and the Ask HR menu item is hidden.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash-lite
